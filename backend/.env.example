# TapPay Backend — Environment Variables
# Copy this file to .env and fill in the values

# Server port
PORT=3001

# Monad Testnet RPCs (failover order)
RPC_PRIMARY=https://testnet-rpc.monad.xyz
RPC_FALLBACK1=https://rpc.ankr.com/monad_testnet
RPC_FALLBACK2=https://rpc-testnet.monadinfra.com

# Deployed contract addresses — fill after deployment
USERNAME_REGISTRY_ADDRESS=
TAP_PAY_LEDGER_ADDRESS=

# Session settings
SESSION_EXPIRY_SECONDS=120
SESSION_SWEEP_INTERVAL_MS=30000

# Database file path (relative to backend/)
DB_PATH=./data/tappay.db

# CORS (comma-separated origins, or * for dev)
CORS_ORIGINS=*
