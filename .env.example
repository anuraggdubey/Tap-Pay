# TapPay — Environment Variables
# Copy this file to .env and fill in the values. .env is git-ignored: never commit real values.

# ── App build-time config (required for release builds) ──
# Inlined into the JS bundle when Metro builds it (scripts/babel-inline-app-config.js).
# Shell/CI environment variables with the same names take precedence over this file.
# After changing them, restart Metro with: npm start -- --reset-cache
# Example: TAPPAY_SUPABASE_URL=https://<project-ref>.supabase.co
TAPPAY_SUPABASE_URL=
TAPPAY_SUPABASE_ANON_KEY=

# ── Contracts ──

# Private key for contract deployment (WITHOUT 0x prefix)
# Fund this address from https://faucet.monad.xyz before deploying
DEPLOYER_PRIVATE_KEY=your_private_key_here
